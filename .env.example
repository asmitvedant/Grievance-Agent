# Copy to .env and edit.

# ---- Qwen, served locally ----
LLM_BACKEND=ollama                       # ollama | openai (vLLM, LM Studio, llama.cpp server) | mock (tests only)
LLM_MODEL=qwen2.5:7b-instruct            # low-RAM laptops: qwen2.5:3b-instruct
OLLAMA_HOST=http://localhost:11434
# OPENAI_BASE_URL=http://localhost:8000/v1
LLM_TIMEOUT=600                          # seconds per call; laptops need a generous limit
DIALOGUE_TEMPERATURE=0.3
LLM_SEED=7
USE_LLM_URGENCY_JUDGE=1

# ---- MySQL case store ----
DATABASE_URL=mysql+pymysql://grievance:grievance-pass@localhost:3306/grievance?charset=utf8mb4
# Quick start without MySQL (development only):
# DATABASE_URL=sqlite:///data/dev.db

# ---- local models (downloaded once by scripts/download_models.py, then run offline) ----
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NLI_BACKEND=cross-encoder
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_THRESHOLD=0.5
KNN_SIMILARITY_THRESHOLD=0.62

# ---- privacy ----
PII_BACKEND=regex
RETENTION_DAYS=365

# ---- institution ----
INSTITUTION_NAME=ABC Institute of Technology
REVIEWER_PASSWORD=change-me
SUPPORT_CONTACTS=Emergency: 112 | Tele-MANAS, free and 24x7: 14416 or 1-800-891-4416 | Campus counselling centre: <add number>
